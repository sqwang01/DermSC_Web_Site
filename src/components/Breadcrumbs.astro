---
/**
 * Breadcrumb trail + BreadcrumbList JSON-LD. Omit on the home page.
 * `crumbs` is ordered root → current. The last item is the current page (not linked).
 * A single-crumb trail (cosmetic procedure pages, D25) renders the page name only and
 * emits no JSON-LD — a one-item BreadcrumbList carries no information. When that single
 * crumb has an `href`, it renders as a back link — `‹ <label>` pointing at the parent
 * section — so the procedure pages keep a way up to /cosmetic/ (D29).
 */
import { siteMeta } from '@data/site';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const backLink = crumbs.length === 1 && crumbs[0].href ? crumbs[0] : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, siteMeta.origin).href } : {}),
  })),
};
---

{
  backLink ? (
    <nav class="crumbs crumbs--back" aria-label="Breadcrumb">
      <a href={backLink.href}><span class="crumbs__chevron" aria-hidden="true">‹</span>{backLink.label}</a>
    </nav>
  ) : (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (
          <li>
            {c.href && i < crumbs.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

{
  crumbs.length > 1 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  )
}

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    padding: 0;
    font-size: var(--fs-small);
    color: var(--stone);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-3);
    color: var(--line);
  }

  .crumbs a {
    color: var(--stone);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }
  .crumbs a:hover {
    color: var(--evergreen);
  }

  .crumbs [aria-current='page'] {
    color: var(--ink);
  }

  /* Single-crumb back link (cosmetic procedure pages, D29) */
  .crumbs--back .crumbs__chevron {
    display: inline-block;
    margin-right: 0.15em;
    text-decoration: none;
  }
</style>

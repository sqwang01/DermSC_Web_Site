---
/**
 * Provider summary card. Uses the client-supplied portrait (2026-08-29).
 * Portraits are low-resolution source files — capped at a small square crop so they
 * stay sharp; replace with proper headshots when available (no lab-coat-on-white,
 * no stock — style guide §7).
 */
import { Image } from 'astro:assets';
import type { Provider } from '@data/site';

interface Props {
  provider: Provider;
  /** Link to the full bio. */
  showLink?: boolean;
  /** Override the provider's default card line for a page-specific context. */
  line?: string;
}

const { provider, showLink = true, line } = Astro.props;
const cardLine = line ?? provider.cardLine;
const bioHref = `/about/${provider.slug}/`;
// "Dr. Maryam Moinfar" -> "Dr. Moinfar"; "Madeline Fee, PA-C" -> "Madeline Fee"
const parts = provider.name.replace(/,.*$/, '').split(' ');
const shortName = provider.name.startsWith('Dr.')
  ? `Dr. ${parts[parts.length - 1]}`
  : `${parts[0]} ${parts[1] ?? ''}`.trim();
---

<article class="pc">
  <Image
    class="pc__photo"
    src={provider.photo}
    alt={provider.photoAlt}
    width={320}
    height={320}
    densities={[1, 2]}
  />
  <div class="pc__body">
    <h3 class="pc__name">{provider.name}</h3>
    <p class="pc__cred">{provider.credential}</p>
    <p class="pc__line">{cardLine}</p>
    {
      showLink && (
        <a class="pc__link link-underline" href={bioHref}>
          Read {shortName}’s bio
        </a>
      )
    }
  </div>
</article>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pc__photo {
    width: 100%;
    max-width: 180px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .pc__name {
    margin-bottom: var(--space-1);
  }

  .pc__cred {
    font-size: var(--fs-small);
    color: var(--stone);
    margin-bottom: var(--space-3);
  }

  .pc__line {
    max-width: 44ch;
    margin-bottom: var(--space-3);
  }
</style>

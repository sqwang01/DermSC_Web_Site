---
/**
 * Shared shell for the single-modality Restore (Cosmetic) treatment pages:
 * neuromodulators, fillers, collagen stimulators, laser, thread lift, chemical
 * peels, microneedling. Structure follows brand-positioning-v2.md §11.2 and matches
 * the layout the combined injectables-and-laser page used before it was split
 * (decisions.md D24). Candidacy and methodology language only — no outcome or
 * percentage claims (§9.1). Brass sub-brand, Restore pages only.
 *
 * The consultation-and-pricing block (§12.10 + §12.8 verbatim), the "why here"
 * paragraph (§7.2, closing on §7.6 sentence 5), the treatment-visit steps, the
 * evidence statement, and the closing CTA are identical across all seven pages and
 * live here. Per-page copy comes in as props; `cross-sell` is a slot so each page
 * can link its own siblings.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Faq from '@components/Faq.astro';
import ProviderCard from '@components/ProviderCard.astro';
import Button from '@components/Button.astro';
import { practice, providers } from '@data/site';

interface Offering {
  name: string;
  body: string | string[];
}
interface QA {
  q: string;
  a: string | string[];
}
interface Props {
  title: string;
  description: string;
  path: string;
  /** MedicalProcedure JSON-LD for this modality (FAQPage comes from <Faq>). */
  schema: Record<string, unknown>[];
  breadcrumbLabel: string;
  h1: string;
  lede: string;
  offeredHeading?: string;
  offerings: Offering[];
  /** Optional stone-toned note under the offerings grid (e.g. a maintenance caveat). */
  offeredNote?: string;
  /** Defaults to the standard five-step visit; override only if a modality differs. */
  visitSteps?: string[];
  candidacyGoodFit: string;
  candidacyNotRight: string;
  /**
   * Who delivers the treatment, after Dr. Moinfar's assessment. She injects filler,
   * collagen stimulators, and places threads herself; the physician assistants perform
   * neuromodulators, microneedling, laser/IPL, and peels (client, 2026-08-29, D24).
   */
  whoPerforms: string;
  /**
   * Slugs of the providers who deliver this modality, shown as cards in "Who
   * you'll see" alongside Dr. Moinfar. Set to the two physician assistants on the
   * modalities they perform (neuromodulators, laser/IPL, peels, microneedling);
   * leave unset for the modalities Dr. Moinfar performs herself.
   */
  alsoSeenSlugs?: string[];
  faqs: QA[];
}

const {
  title,
  description,
  path,
  schema,
  breadcrumbLabel,
  h1,
  lede,
  offeredHeading = 'What’s offered',
  offerings,
  offeredNote,
  candidacyGoodFit,
  candidacyNotRight,
  whoPerforms,
  faqs,
} = Astro.props;

const visitSteps = Astro.props.visitSteps ?? [
  'Assessment — we look at the area, review your history and medications, and agree on what’s realistic.',
  'Standardized photographs at baseline, on a fixed protocol.',
  'The treatment itself.',
  'Recovery — what to expect, and for how long.',
  'A follow-up, with photographs, to see what the treatment actually did.',
];

const toParas = (v: string | string[]) => (Array.isArray(v) ? v : [v]);
const moinfar = providers.find((p) => p.slug === 'dr-maryam-moinfar')!;
const alsoSeen = (Astro.props.alsoSeenSlugs ?? []).map((slug) =>
  providers.find((p) => p.slug === slug)!
);
---

<BaseLayout title={title} description={description} path={path} schema={schema} restore>
  <!-- 1 · Hero -->
  <SectionBand as="div" class="hero">
    <Breadcrumbs
      crumbs={[{ label: breadcrumbLabel, href: '/cosmetic/#menu-heading' }]}
      backAriaLabel="Back to Cosmetic"
    />
    <div class="hero__copy" data-reveal>
      <span class="eyebrow">{breadcrumbLabel} — under a physician’s direction</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <div class="hero__cta">
        <Button href="/contact/" variant="restore">Book a consultation</Button>
        <Button href="#how-it-works" variant="secondary">How it works ↓</Button>
      </div>
    </div>
  </SectionBand>

  <!-- 2 · What's offered -->
  <SectionBand id="how-it-works" tone="fog" aria-labelledby="offered-heading">
    <h2 id="offered-heading" class="section-title" data-reveal>{offeredHeading}</h2>
    <div class="offerings" data-reveal>
      {
        offerings.map((o) => (
          <article class="offering prose">
            <h3>{o.name}</h3>
            {toParas(o.body).map((p) => (
              <p>{p}</p>
            ))}
          </article>
        ))
      }
    </div>
    {
      offeredNote && (
        <p class="offerings__note" data-reveal>
          {offeredNote}
        </p>
      )
    }
  </SectionBand>

  <!-- 3 · How a treatment visit works -->
  <SectionBand aria-labelledby="visit-heading">
    <div class="prose" data-reveal>
      <h2 id="visit-heading">How a treatment visit works</h2>
      <ol class="steps">
        {visitSteps.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </SectionBand>

  <!-- 4 · Candidacy -->
  <SectionBand tone="fog" aria-labelledby="candidacy-heading">
    <div class="prose" data-reveal>
      <h2 id="candidacy-heading">Candidacy</h2>
      <p><strong>A good fit</strong> {candidacyGoodFit}</p>
      <p><strong>Not right for you</strong> {candidacyNotRight}</p>
    </div>
  </SectionBand>

  <!-- 5 · Why here rather than a storefront (§7.2 claim-then-structure; client copy, 2026-08-29) -->
  <SectionBand tone="evergreen" aria-labelledby="why-heading">
    <div class="prose prose--on-dark" data-reveal>
      <h2 id="why-heading">Why here rather than a storefront</h2>
      <p>
        Dr. Moinfar assesses you. She won’t book a treatment that’s wrong for you, or more of it
        than you need — no one upstream sets a quota telling her otherwise. That’s why you can trust
        it.
      </p>
    </div>
  </SectionBand>

  <!-- 6 · Who you'll see -->
  <SectionBand aria-labelledby="team-heading">
    <h2 id="team-heading" class="section-title" data-reveal>Who you’ll see</h2>
    <div class:list={['team', { 'team--multi': alsoSeen.length }]} data-reveal>
      <div class="team__cards">
        <ProviderCard provider={moinfar} />
        {alsoSeen.map((p) => <ProviderCard provider={p} />)}
      </div>
      <p class="team__note">{whoPerforms}</p>
    </div>
  </SectionBand>

  <!-- 7 · Evidence -->
  <SectionBand tone="fog" aria-labelledby="evidence-heading">
    <div class="prose" data-reveal>
      <h2 id="evidence-heading">Evidence</h2>
      <p>
        Results here are photographed at baseline and follow-up on a fixed protocol. We publish only
        our own images, and consented sets are still being built. We don’t use stock photography or
        borrowed before-and-afters.
      </p>
    </div>
  </SectionBand>

  <!-- 8 · The consultation & pricing (§12.10 verbatim; §12.8 opener, minus the "price is the price" line per client 2026-08-29) -->
  <SectionBand aria-labelledby="pricing-heading">
    <div class="prose" data-reveal>
      <h2 id="pricing-heading">The consultation &amp; pricing</h2>
      <p>
        A consultation takes twenty minutes. We’ll look at the area you’re concerned about, review
        your health history and medications, and tell you plainly whether this will help — and what
        it won’t do.
      </p>
      <p>
        Itemized pricing is provided in writing at the consultation; there’s no published price
        list.
      </p>
    </div>
  </SectionBand>

  <!-- 9 · FAQ -->
  <SectionBand tone="fog" aria-labelledby="faq-heading">
    <Faq heading="Questions patients ask" items={faqs} />
  </SectionBand>

  <!-- 10 · Closing CTA -->
  <SectionBand tone="evergreen-deep" aria-labelledby="cta-heading">
    <div class="closing" data-reveal>
      <h2 id="cta-heading">Book a consultation</h2>
      <p>
        A consultation is twenty minutes and a straight answer about whether a treatment will help.
        Leave your name and number and our team will call you back.
      </p>
      <div class="closing__cta">
        <Button href="/contact/" variant="restore">Book a consultation</Button>
        <Button href={`tel:${practice.phoneHref}`} variant="secondary">
          Call {practice.phone}
        </Button>
      </div>
    </div>
  </SectionBand>

  <!-- 11 · Cross-sell -->
  <SectionBand aria-labelledby="more-heading">
    <div class="more" data-reveal>
      <h2 id="more-heading" class="section-title">Related</h2>
      <slot name="cross-sell" />
    </div>
  </SectionBand>
</BaseLayout>

<style>
  /* Hero — padding-block from .section; the breadcrumb carries the gap to the copy
     (global .hero .crumbs); h1 → .lede gap is global. */

  /* Offerings */
  .offerings {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 760px) {
    .offerings {
      grid-template-columns: 1fr 1fr;
    }
  }
  .offerings__note {
    margin-top: var(--space-12);
    max-width: var(--wrap-prose);
    color: var(--stone);
  }

  /* Visit steps — measure, list indent and li spacing come from .prose */

  /* Who you'll see — base grid + gap from the shared .team */
  .team__cards {
    display: grid;
    gap: var(--space-6);
  }
  /* PAs deliver this modality: stack the provider cards as full-width rows
     with a hairline between, so each name and role has room. Photo above the
     text on narrow screens, beside it from 760px. */
  .team--multi .team__cards {
    gap: 0;
  }
  .team--multi .team__cards :global(.pc) {
    padding-block: var(--space-8);
    border-top: var(--border-hair);
  }
  .team--multi .team__cards :global(.pc:first-child) {
    padding-top: 0;
  }
  .team--multi .team__cards :global(.pc:last-child) {
    padding-bottom: 0;
  }
  @media (min-width: 760px) {
    /* One provider: card beside the note. */
    .team:not(.team--multi) {
      grid-template-columns: 320px 1fr;
      align-items: start;
      gap: var(--space-12);
    }
    .team--multi .team__cards :global(.pc) {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-12);
    }
    .team--multi .team__cards :global(.pc__photo) {
      flex: 0 0 auto;
      width: 160px;
    }
  }
  .team__note {
    max-width: var(--wrap-narrow);
    color: var(--stone);
  }
  .team--multi .team__note {
    max-width: var(--wrap-prose);
  }

  /* Closing — .closing / .closing__cta are shared */
  .more {
    max-width: var(--wrap-prose);
  }
  .more :global(p + p) {
    margin-top: var(--space-6);
  }
</style>

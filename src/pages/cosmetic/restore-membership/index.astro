---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Faq from '@components/Faq.astro';
import Button from '@components/Button.astro';
import { practice } from '@data/site';

const title = 'The Restore Membership · Dana Point';
const description =
  'A priority annual skin exam, regular skin-health visits, and member pricing on cosmetic and Restore services at Advanced Dermatology in Dana Point. Pricing being finalized.';

// Placeholder pricing per D17 — client confirms the final number and inclusions before launch.
// Stated as plain figures, no "free" / discount framing (§8.3, §12.8).
const price = { monthly: '$149', annual: '$1,490', annualIfMonthly: '$1,788' };

// D17 placeholder inclusions. Plain table, no checkmark-spam.
const included = [
  { item: 'Priority annual skin exam with a provider', freq: 'Once a year' },
  { item: 'Skin-health visits', freq: 'Twice a year' },
  { item: 'Standardized photography baseline set', freq: 'Once a year' },
  { item: 'Member pricing on cosmetic and Restore services', freq: 'Ongoing' },
  { item: 'Priority scheduling for routine visits, and a direct line', freq: 'Ongoing' },
];

const faqs = [
  {
    q: 'Can I pause it?',
    a: 'Yes, per the practice’s cancellation and pause policy. Ask our team for the current terms.',
  },
  {
    q: 'Is this insurance?',
    a: 'No. It doesn’t replace insurance, and anything billable to your plan is still billed to your plan.',
  },
  {
    q: 'What if I move away?',
    a: 'You can cancel under the practice policy. The membership only makes sense if you’re seen here regularly.',
  },
  {
    q: 'Does it cover Mohs surgery or skin cancer treatment?',
    a: 'No. Medically necessary care is billed to insurance and scheduled on clinical need, not on membership.',
  },
  {
    q: 'Can non-members still book cosmetic services?',
    a: 'Yes. Membership changes the pricing and the scheduling cadence, not access.',
  },
  {
    q: 'Does membership move me ahead for an urgent spot?',
    a: 'No. A concerning or changing spot is triaged on clinical need for everyone, member or not.',
  },
];
---

<BaseLayout title={title} description={description} path="/cosmetic/restore-membership/" restore>
  <!-- 1 · Hero -->
  <SectionBand as="div" class="hero">
    <Breadcrumbs
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Cosmetic', href: '/cosmetic/' },
        { label: 'The Restore Membership', href: '/cosmetic/restore-membership/' },
      ]}
    />
    <div class="hero__copy" data-reveal>
      <span class="eyebrow">Restore — under a physician’s direction</span>
      <h1>The practice you already trust, on a schedule.</h1>
      <p class="hero__sub">
        The same people, in the same building, on a set cadence. It is a care schedule, not a
        loyalty tier, and it is not insurance.
      </p>
      <div class="hero__cta">
        <Button href="/contact/" variant="restore">Join Restore</Button>
        <Button href="#whats-included" variant="secondary">See what’s included →</Button>
      </div>
    </div>
  </SectionBand>

  <!-- 2 · Who it's for, and who it isn't -->
  <SectionBand tone="fog" aria-labelledby="fit-heading">
    <div class="prose" data-reveal>
      <h2 id="fit-heading">Who it’s for, and who it isn’t</h2>
      <p>
        <strong>For:</strong> patients who want their skin looked at on a regular schedule without
        chasing an appointment each time, and who use cosmetic or Restore services.
      </p>
      <p>
        <strong>Not for:</strong> anyone after a discount club, or something that acts like
        insurance.
      </p>
      <p class="note">
        If you come in twice a year anyway, this mostly just formalizes that — it is not a discount
        club.
      </p>
    </div>
  </SectionBand>

  <!-- 3 · What's included (D17 placeholder inclusions) -->
  <SectionBand id="whats-included" aria-labelledby="included-heading">
    <h2 id="included-heading" class="section-title" data-reveal>What’s included</h2>
    <div class="included__scroll" data-reveal>
      <table class="included">
        <thead>
          <tr>
            <th scope="col">Included</th>
            <th scope="col">How often</th>
          </tr>
        </thead>
        <tbody>
          {
            included.map((row) => (
              <tr>
                <th scope="row">{row.item}</th>
                <td>{row.freq}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="included__note" data-reveal>Inclusions are provisional pending final confirmation.</p>
  </SectionBand>

  <!-- 4 · What it costs (D17 placeholder — marked provisional) -->
  <SectionBand tone="fog" aria-labelledby="cost-heading">
    <div class="prose" data-reveal>
      <h2 id="cost-heading">What it costs</h2>
      <p class="price">
        <strong>{price.monthly}/month</strong>, or {price.annual} paid once a year — compared with
        {price.annualIfMonthly} at the monthly rate.
      </p>
      <p class="note">Pricing is being finalized — this figure is provisional.</p>
    </div>
  </SectionBand>

  <!-- 5 · What it is not -->
  <SectionBand aria-labelledby="isnot-heading">
    <div class="prose" data-reveal>
      <h2 id="isnot-heading">What it is not</h2>
      <ul class="list">
        <li>
          It is not insurance and does not replace it. Visits billable to insurance are still
          billed to insurance.
        </li>
        <li>
          It does not cover Mohs surgery or any medically necessary treatment — those are scheduled
          on clinical need, not membership.
        </li>
        <li>
          Refund and cancellation terms are set by practice policy.
          {/* TODO(client): link to the policy page once it exists. */}
        </li>
      </ul>
    </div>
  </SectionBand>

  <!-- 6 · How it works month to month -->
  <SectionBand tone="fog" aria-labelledby="how-heading">
    <div class="prose" data-reveal>
      <h2 id="how-heading">How it works month to month</h2>
      <ol class="steps">
        <li>Join.</li>
        <li>Schedule your baseline photography and first visit.</li>
        <li>Book visits against the annual allowance.</li>
        <li>Member pricing is applied at checkout.</li>
        <li>Pause or cancel per practice policy.</li>
      </ol>
    </div>
  </SectionBand>

  <!-- 7 · The continuity paragraph (§12.6, verbatim) -->
  <SectionBand tone="evergreen" aria-labelledby="continuity-heading">
    <div class="band-prose" data-reveal>
      <h2 id="continuity-heading">The same faces, year to year</h2>
      <p>
        Dr. Moinfar and Dr. Lander trained together in residency and have practiced side by side for
        nearly twenty-five years. Two of our physician assistants started here as medical assistants
        — they went to PA school because of what they learned at the exam table here, and they came
        back to the building where they started. Dermatology has a turnover problem. We don’t.
      </p>
    </div>
  </SectionBand>

  <!-- 8 · FAQ -->
  <SectionBand aria-labelledby="faq-heading">
    <Faq heading="Questions patients ask" items={faqs} />
  </SectionBand>

  <!-- 9 · Closing CTA -->
  <SectionBand tone="evergreen-deep" aria-labelledby="cta-heading">
    <div class="closing" data-reveal>
      <h2 id="cta-heading">Join Restore</h2>
      <p>
        A membership is a care schedule with member pricing attached. Leave your name and number and
        our team will walk you through the current terms.
      </p>
      <div class="closing__cta">
        <Button href="/contact/" variant="restore">Join Restore</Button>
        <Button href={`tel:${practice.phoneHref}`} variant="secondary">
          Call {practice.phone}
        </Button>
      </div>
    </div>
  </SectionBand>

  <!-- 10 · Cross-sell -->
  <SectionBand aria-labelledby="more-heading">
    <div class="more" data-reveal>
      <h2 id="more-heading" class="section-title">Related</h2>
      <ul class="more__list">
        <li>
          New to Restore? The <a class="link-underline" href="/cosmetic/">cosmetic overview</a>
          lists what’s offered.
        </li>
        <li>
          The program is directed by
          <a class="link-underline" href="/about/dr-maryam-moinfar/">Dr. Maryam Moinfar</a>.
        </li>
      </ul>
    </div>
  </SectionBand>
</BaseLayout>

<style>
  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Hero */
  .hero {
    padding-block: var(--section-y);
  }
  .hero__copy {
    margin-top: var(--space-8);
  }
  .hero__sub {
    color: var(--stone);
    margin-top: var(--space-3);
    max-width: 60ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* Generic prose */
  .prose {
    max-width: 60ch;
  }
  .prose h2 {
    margin-bottom: var(--space-6);
  }
  .prose p + p {
    margin-top: var(--space-4);
  }
  .note {
    color: var(--stone);
  }
  .price strong {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--fs-h3);
    color: var(--evergreen);
  }
  .list {
    padding-left: 1.1rem;
    margin-top: var(--space-6);
  }
  .list li + li {
    margin-top: var(--space-3);
  }
  .steps {
    padding-left: 1.4rem;
    margin-top: var(--space-6);
  }
  .steps li + li {
    margin-top: var(--space-4);
  }

  /* Evergreen band prose */
  .band-prose {
    max-width: 60ch;
  }
  .band-prose h2 {
    margin-bottom: var(--space-6);
  }

  /* What's included table */
  .included__scroll {
    overflow-x: auto;
  }
  .included {
    border-collapse: collapse;
    width: 100%;
    max-width: 44rem;
  }
  .included th,
  .included td {
    text-align: left;
    padding: var(--space-4) var(--space-6);
    border-bottom: var(--border-hair);
    vertical-align: top;
  }
  .included thead th {
    font-family: var(--body);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--stone);
    border-bottom: 1.5px solid var(--line);
  }
  .included tbody th {
    font-family: var(--body);
    font-weight: 600;
    color: var(--ink);
  }
  .included tbody td {
    color: var(--stone);
    white-space: nowrap;
  }
  .included__note {
    margin-top: var(--space-6);
    font-size: var(--fs-small);
    color: var(--stone);
  }

  /* Closing */
  .closing {
    max-width: 60ch;
  }
  .closing h2 {
    margin-bottom: var(--space-6);
  }
  .closing__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* Cross-sell */
  .more {
    max-width: 60ch;
  }
  .more__list {
    list-style: none;
    padding-left: 0;
  }
  .more__list li {
    padding-top: var(--space-6);
    border-top: var(--border-hair);
  }
  .more__list li + li {
    margin-top: var(--space-6);
  }
</style>

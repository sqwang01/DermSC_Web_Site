---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import Card from '@components/Card.astro';
import Faq from '@components/Faq.astro';
import ProviderCard from '@components/ProviderCard.astro';
import Button from '@components/Button.astro';
import { practice, providers } from '@data/site';

const title = 'Cosmetic Dermatology in Dana Point · Restore';
const description =
  'Injectables, lasers, and body contouring in Dana Point, kept deliberately conservative — Restore, a physician-directed program inside a twenty-year medical practice.';

const moinfar = providers.find((p) => p.slug === 'dr-maryam-moinfar')!;

// Menu — one sentence each, in the patient's language (content-spec → Cosmetic hub §3).
// Split into face and body/hair after the injectables-and-laser page was broken out
// into seven single-modality pages and the membership was retired (decisions.md D24).
const menuGroups = [
  {
    heading: 'For the face',
    items: [
      {
        href: '/cosmetic/neuromodulators/',
        label: 'Neuromodulators',
        line: 'Botox, Dysport, and the muscles that etch lines in.',
      },
      {
        href: '/cosmetic/fillers/',
        label: 'Dermal fillers',
        line: 'Hyaluronic acid, to replace volume that has been lost.',
      },
      {
        href: '/cosmetic/collagen-stimulators/',
        label: 'Collagen-stimulating injectables',
        line: 'Prompt your own collagen, gradually, over months.',
      },
      {
        href: '/cosmetic/laser/',
        label: 'Laser & IPL',
        line: 'VBeam and IPL — for redness, vessels, and brown sun spots.',
      },
      {
        href: '/cosmetic/thread-lift/',
        label: 'Silhouette InstaLift',
        line: 'Dissolvable sutures for a little lift, no operating room.',
      },
      {
        href: '/cosmetic/chemical-peels/',
        label: 'Chemical peels',
        line: 'Surface renewal for tone and texture, usually a short series.',
      },
      {
        href: '/cosmetic/microneedling/',
        label: 'Microneedling',
        line: 'Controlled micro-injury that builds collagen gradually.',
      },
    ],
  },
  {
    heading: 'For the body and hair',
    items: [
      {
        href: '/cosmetic/emsculpt-neo/',
        label: 'EmSculpt Neo',
        line: 'Muscle and fat, in one 30-minute treatment.',
      },
      {
        href: '/cosmetic/coolsculpting/',
        label: 'CoolSculpting',
        line: 'Cryolipolysis for pinchable fat.',
      },
      {
        href: '/cosmetic/hair-restoration/',
        label: 'Hair restoration',
        line: 'Hair loss is a symptom. We find out of what.',
      },
    ],
  },
];

const faqs = [
  {
    q: 'Is a consultation an obligation to book?',
    a: 'No. It’s twenty minutes to find out whether a treatment fits what you want to change. If it doesn’t, we’ll say so, and there’s nothing to schedule.',
  },
  {
    q: 'Will results look natural?',
    a: 'That’s the whole intent. Everything here is dosed conservatively and matched to your own face and body. Most patients hear that they look rested, not that they look different.',
  },
  {
    q: 'Who performs the treatments?',
    a: 'Dr. Moinfar assesses every patient. She injects filler and collagen stimulators and places threads herself; our physician assistants perform neuromodulators, microneedling, laser and IPL, and peels.',
  },
  {
    q: 'Do you photograph results?',
    a: 'Yes. We take standardized photographs at baseline and follow-up, on a fixed protocol, so you and the physician are looking at evidence rather than impressions.',
  },
  // TODO(client): "Do you offer payment plans?" — held until the practice confirms.
];
---

<BaseLayout title={title} description={description} path="/cosmetic/" restore>
  <!-- 1 · Hero -->
  <SectionBand as="div" class="hero">
    <div class="hero__copy" data-reveal>
      <span class="eyebrow">Restore — under a physician’s direction</span>
      <h1>Nobody should be able to tell. That’s the whole job.</h1>
      <p class="lede">
        Injectables, lasers, microneedling, and body contouring — offered by the same practice that
        reads your pathology, and kept intentionally conservative. Everything here is meant to look
        like you ten years ago, not like work.
      </p>
      <div class="hero__cta">
        <Button href="/contact/" variant="restore">Book a consultation</Button>
        <Button href="#how-it-works" variant="secondary">How it works ↓</Button>
      </div>
    </div>
  </SectionBand>

  <!-- 2 · Our philosophy (client-supplied copy, 2026-08-29 — supersedes the §7.6 verbatim lines here) -->
  <SectionBand id="how-it-works" tone="evergreen" aria-labelledby="restraint-heading">
    <div class="band-prose" data-reveal>
      <h2 id="restraint-heading">Our philosophy</h2>
      <p>
        Good cosmetic work can’t be pointed to. Nobody says you look different. They say you look
        well. Every procedure here is chosen and dosed toward that.
      </p>
      <p>
        It isn’t one injection or one laser pass. It’s a plan — what to treat, what to leave alone,
        how much, revisited over months. That planning is the skill. The needle just carries it out.
      </p>
      <p>
        A board-certified dermatologist builds that plan. When a treatment won’t get you what you’re
        after, she’ll say so — and recommend against it, not book it. That’s why a physician is in
        the room before anything is scheduled.
      </p>
    </div>
  </SectionBand>

  <!-- 3 · The menu -->
  <SectionBand tone="fog" aria-labelledby="menu-heading">
    <h2 id="menu-heading" class="section-title" data-reveal>What Restore covers</h2>
    {
      menuGroups.map((g) => (
        <div class="menu-group" data-reveal>
          <h3 class="menu-group__heading">{g.heading}</h3>
          <ul class="menu">
            {g.items.map((m) => (
              <li>
                <Card href={m.href} restore>
                  <span class="menu__label">{m.label}</span>
                  <span class="menu__line">{m.line}</span>
                </Card>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </SectionBand>

  <!-- 4 · Who you'll see -->
  <SectionBand aria-labelledby="team-heading">
    <h2 id="team-heading" class="section-title" data-reveal>Who you’ll see</h2>
    <div class="team" data-reveal>
      <ProviderCard provider={moinfar} />
      <p class="team__note">
        Dr. Maryam Moinfar leads Restore and assesses every patient herself. She injects filler and
        collagen stimulators and places threads; our physician assistants perform neuromodulators,
        microneedling, laser and IPL, and peels.
      </p>
    </div>
  </SectionBand>

  <!-- 5 · The consultation (§12.10, verbatim) -->
  <SectionBand aria-labelledby="consult-heading">
    <div class="prose" data-reveal>
      <h2 id="consult-heading">The consultation</h2>
      <p>
        A consultation takes twenty minutes. We’ll look at the area you’re concerned about, review
        your health history and medications, and tell you plainly whether this will help — and what
        it won’t do.
      </p>
    </div>
  </SectionBand>

  <!-- 6 · FAQ -->
  <SectionBand tone="fog" aria-labelledby="faq-heading">
    <Faq heading="Questions patients ask" items={faqs} />
  </SectionBand>

  <!-- 7 · Closing CTA -->
  <SectionBand tone="evergreen-deep" aria-labelledby="cta-heading">
    <div class="closing" data-reveal>
      <h2 id="cta-heading">Book a consultation</h2>
      <p>
        A consultation is twenty minutes and a straight answer. Leave your name and number and our
        team will call you back.
      </p>
      <div class="closing__cta">
        <Button href="/contact/" variant="restore">Book a consultation</Button>
        <Button href={`tel:${practice.phoneHref}`} variant="secondary">
          Call {practice.phone}
        </Button>
      </div>
    </div>
  </SectionBand>

  <!-- 8 · Cross-sell -->
  <SectionBand aria-labelledby="more-heading">
    <div class="more" data-reveal>
      <h2 id="more-heading" class="section-title">Related</h2>
      <p>
        On a GLP-1 medication and dealing with hair shedding, facial volume loss, or lost strength?
        That has its own program —
        <a class="link-underline" href="/glp-1-restore/">GLP-1 Restore</a>.
      </p>
    </div>
  </SectionBand>
</BaseLayout>

<style>
  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Hero */
  .hero {
    padding-block: var(--space-12) var(--section-y);
  }
  .hero .lede {
    margin-top: var(--space-4);
    max-width: 60ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* Evergreen band prose */
  .band-prose {
    max-width: 60ch;
  }
  .band-prose h2 {
    margin-bottom: var(--space-6);
  }
  .band-prose p + p {
    margin-top: var(--space-6);
  }

  /* Menu */
  .menu-group + .menu-group {
    margin-top: var(--space-12);
  }
  .menu-group__heading {
    font-family: var(--display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--evergreen);
    margin-bottom: var(--space-6);
  }
  .menu {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .menu {
      grid-template-columns: 1fr 1fr;
    }
  }
  .menu__label {
    display: block;
    font-family: var(--display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--evergreen);
  }
  .menu__line {
    display: block;
    margin-top: var(--space-3);
    color: var(--ink);
  }

  /* Who you'll see */
  .team {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 760px) {
    .team {
      grid-template-columns: 320px 1fr;
      align-items: start;
      gap: var(--space-12);
    }
  }
  .team__note {
    max-width: 44ch;
    color: var(--stone);
  }

  /* Generic prose */
  .prose {
    max-width: 60ch;
  }
  .prose h2 {
    margin-bottom: var(--space-6);
  }
  .prose p + p {
    margin-top: var(--space-4);
  }

  /* Closing */
  .closing {
    max-width: 60ch;
  }
  .closing h2 {
    margin-bottom: var(--space-6);
  }
  .closing__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  /* Secondary "Call" button sits on the evergreen-deep band — lift it off the dark. */
  .closing__cta :global(.btn--secondary) {
    color: var(--paper);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .closing__cta :global(.btn--secondary:hover) {
    color: var(--paper);
    border-color: var(--paper);
  }

  /* Cross-sell */
  .more {
    max-width: 60ch;
  }
</style>

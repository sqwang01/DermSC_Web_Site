---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import CalloutClay from '@components/CalloutClay.astro';
import Faq from '@components/Faq.astro';
import ProviderCard from '@components/ProviderCard.astro';
import Button from '@components/Button.astro';
import { practice, providers, siteMeta } from '@data/site';

const title = 'Skin Cancer Treatment & Mohs Surgery · Dana Point';
const description =
  'Fellowship-trained Mohs surgery, reconstruction by the same surgeon, and Sensus SRT radiation for skin cancer in Dana Point. Caught early, it stays a small procedure.';

// Dr. Lander performs Mohs and reconstruction; Dr. Moinfar reads the pathology.
const careTeam = ['dr-jeffrey-lander', 'dr-maryam-moinfar']
  .map((slug) => providers.find((p) => p.slug === slug))
  .filter((p): p is (typeof providers)[number] => Boolean(p));

// MedicalProcedure (Mohs). FAQPage schema is emitted by the Faq component itself.
const mohsSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: 'Mohs micrographic surgery',
  procedureType: 'https://schema.org/SurgicalProcedure',
  bodyLocation: 'Skin',
  howPerformed:
    'The skin cancer is removed one thin layer at a time. Each layer is mapped and examined under the microscope before the next layer is taken, and surgery stops once the margins are clear. Reconstruction is performed by the same surgeon.',
  provider: {
    '@type': 'MedicalBusiness',
    name: practice.legalName,
    '@id': `${siteMeta.origin}/#practice`,
  },
};

const faqs = [
  {
    q: 'How long does Mohs surgery take?',
    a: 'Plan for most of the day, though much of that is waiting while each layer is processed and read under the microscope. Most cases are clear after one or two layers. Bring something to do, and arrange not to work that afternoon.',
  },
  {
    q: 'Will I need reconstruction?',
    a: 'Often, yes — it depends on where the cancer was and how much tissue had to be removed to clear it. Reconstruction is done by the same surgeon who removed the cancer. Some small wounds in certain locations heal well on their own; that decision is made once the cancer is out and the wound is known.',
  },
  {
    q: 'Is Mohs surgery painful?',
    a: 'The area is numbed with local anesthesia, so the surgery itself is not painful. You are awake the whole time. Afterward, most people manage with acetaminophen.',
  },
  {
    q: 'What is superficial radiation therapy?',
    a: 'It treats certain basal and squamous cell skin cancers with low-energy X-rays that reach only the top layers of skin, given over a series of short visits. It is mainly an option for patients who cannot or should not have surgery. The unit we use is the Sensus SRT. Whether it is appropriate depends on the tumor type, size, and location and on your overall health — that is a conversation, not a default.',
  },
  {
    q: 'How soon can I be seen for a changing mole?',
    a: 'Sooner than a routine appointment. When you request a skin check, tell our team the spot is new, changing, bleeding, or not healing, and they will move you up.',
  },
];
---

<BaseLayout title={title} description={description} path="/skin-cancer/" schema={[mohsSchema]}>
  <!-- 1 · Hero -->
  <SectionBand as="div" class="hero">
    <div class="hero__copy" data-reveal>
      <span class="eyebrow">Serious medicine. Natural results.</span>
      <h1>Caught early, it’s a small procedure.</h1>
      <p class="lede">
        Caught late, it’s a different conversation. Screening, Mohs micrographic surgery, and
        reconstruction are all done here — by the same surgeon — for skin cancer in
        Dana Point and South Orange County.
      </p>
      <div class="hero__cta">
        <Button href="/contact/" variant="primary">Request a skin check</Button>
        <Button href="#what-to-watch-for" variant="secondary">What to watch for →</Button>
      </div>
    </div>
  </SectionBand>

  <!-- 2 · What to watch for -->
  <SectionBand tone="fog" id="what-to-watch-for" aria-labelledby="watch-heading">
    <h2 id="watch-heading" class="section-title" data-reveal>What to watch for</h2>
    <div class="watch" data-reveal>
      <p class="watch__intro">
        Most skin cancers are treatable, and the earlier one is found the smaller the treatment. A
        few things are worth a call sooner rather than waiting for an annual visit:
      </p>
      <CalloutClay heading="Tell us if you notice">
        <ul>
          <li>A spot that is new, or one that looks or feels different from your others</li>
          <li>A mole or freckle that is changing — in size, shape, color, or height</li>
          <li>A sore that doesn’t heal within a few weeks, or heals and comes back</li>
          <li>Any spot that bleeds, crusts, or itches without a clear reason</li>
          <li>A patch that is asymmetric, has an irregular border, or has more than one color</li>
        </ul>
      </CalloutClay>
      <p class="watch__note">
        If one of these describes a spot you have, say so when you request an appointment — we
        triage those ahead of routine checks.
      </p>
    </div>
  </SectionBand>

  <!-- 3 · How Mohs works -->
  <SectionBand aria-labelledby="mohs-heading">
    <div class="prose" data-reveal>
      <h2 id="mohs-heading">How Mohs surgery works</h2>
      <p>
        Dr. Jeffrey Lander is a fellowship-trained Mohs surgeon and performs more than 800 Mohs
        cases a year. The cancer is removed one thin layer at a time, with the margins examined
        under the microscope between layers, and the surgery stops the moment they’re clear.
        Reconstruction is done here as well, by the same surgeon — not referred
        out to someone who wasn’t in the room.
      </p>
      <p>
        In practice, that means you’re numbed with local anesthetic, the first layer is taken, and
        then you wait — often an hour or more — while it’s processed and read. If any cancer remains
        at an edge, only that area is treated again. Most cases are clear after one or two layers.
        It spares the most healthy tissue of any method, which matters most on the face, ears, and
        hands.
      </p>
    </div>
  </SectionBand>

  <!-- 4 · The full range -->
  <SectionBand tone="fog" aria-labelledby="range-heading">
    <h2 id="range-heading" class="section-title" data-reveal>The full range, in one building</h2>
    <div class="range" data-reveal>
      <article class="range__item prose">
        <h3>Mohs micrographic surgery</h3>
        <p>
          The tissue-sparing approach described above, for basal and squamous cell carcinomas —
          particularly on the face, head, neck, hands, and lower legs, and for cancers that have
          recurred or have unclear borders.
        </p>
      </article>
      <article class="range__item prose">
        <h3>Reconstruction here</h3>
        <p>
          The same surgeon who removed the cancer repairs the wound. It is not handed to another
          practice or a specialist who wasn’t there. Some small
          wounds in certain locations are left to heal on their own — a decision made once the
          cancer is out and the defect is known.
        </p>
      </article>
      <article class="range__item prose">
        <h3>Superficial radiation therapy (Sensus SRT)</h3>
        <p>
          For some patients, surgery is not the best option — because of age, medications, other
          health conditions, or a lesion in a place that is hard to reconstruct. Superficial
          radiation therapy treats certain skin cancers with low-energy X-rays that reach only the
          top layers of skin, over a series of short visits. The unit we use is the Sensus SRT.
          Whether it’s appropriate depends on the tumor and your health, and we’ll talk it through
          before anything is scheduled.
        </p>
      </article>
      <article class="range__item prose">
        <h3>Photodynamic therapy and field treatment</h3>
        <p>
          When sun damage is spread across an area rather than concentrated in one spot — many
          rough, scaly precancerous patches at once — a light-activated medication applied in the
          office can treat the whole field instead of one lesion at a time.
        </p>
      </article>
      <article class="range__item prose">
        <h3>Biopsy and pathology</h3>
        <p>
          A biopsy is processed in our own lab and read by a dermatopathologist Dr. Moinfar
          selected personally — not one assigned by a contract. That reading determines everything
          that happens next, and every week she reviews the pathology from all of our providers
          herself.
        </p>
      </article>
    </div>
  </SectionBand>

  <!-- 5 · Candidacy -->
  <SectionBand aria-labelledby="candidacy-heading">
    <h2 id="candidacy-heading" class="section-title" data-reveal>Is Mohs surgery right for you?</h2>
    <div class="candidacy" data-reveal>
      <div class="candidacy__col">
        <h3>It’s often the right approach if</h3>
        <ul>
          <li>
            You have a biopsy-confirmed basal or squamous cell carcinoma on the face, head, neck,
            hands, or lower legs
          </li>
          <li>A skin cancer has come back after a previous treatment</li>
          <li>An earlier excision came back with a positive or unclear margin</li>
          <li>You want the method that removes the least healthy tissue to clear the cancer</li>
        </ul>
      </div>
      <div class="candidacy__col">
        <h3>It’s not the path if</h3>
        <ul>
          <li>The diagnosis isn’t confirmed yet — that starts with a skin check and a biopsy</li>
          <li>
            The cancer is a type or stage better managed another way, or by a surgical oncologist —
            we’ll tell you plainly and help arrange it
          </li>
          <li>Surgery carries more risk than benefit for you — radiation may be the better option</li>
        </ul>
      </div>
    </div>
  </SectionBand>

  <!-- 6 · Why here (claim, then structure — §7.2) -->
  <SectionBand tone="evergreen" aria-labelledby="why-heading">
    <div class="band-prose" data-reveal>
      <h2 id="why-heading">Why here rather than anywhere with a scalpel</h2>
      <p>
        Plenty of places can cut out a skin cancer. Fewer can read the margin while you wait, repair
        the wound with the same hands, and offer radiation to the patient who shouldn’t
        be cut at all.
      </p>
      <p>
        We’ve kept a radiation unit for the patients who need it — even though it isn’t the most
        profitable room in the building — because nobody upstream was ever going to ask what its
        margin was.
      </p>
      <p>Physicians in our community bring their own spouses and friends here.</p>
      <p>
        <a class="link-underline band-prose__link" href="/about/">How the practice is set up</a>
      </p>
    </div>
  </SectionBand>

  <!-- 7 · Who you'll see -->
  <SectionBand tone="fog" aria-labelledby="team-heading">
    <h2 id="team-heading" class="section-title" data-reveal>Who you’ll see</h2>
    <div class="team" data-reveal>
      {careTeam.map((p) => <ProviderCard provider={p} />)}
    </div>
    <p class="team__note" data-reveal>
      Dr. Lander removes the cancer and performs the reconstruction. Dr. Moinfar reads and reviews
      the pathology. They trained together in residency and have practiced side by side for nearly
      twenty-five years.
    </p>
  </SectionBand>

  <!-- 8 · Surveillance / what happens after -->
  <SectionBand aria-labelledby="after-heading">
    <div class="prose" data-reveal>
      <h2 id="after-heading">What happens after</h2>
      <p>
        Once you’ve had one skin cancer, you’re more likely to develop another, most often within
        the first few years. We set a recall schedule — often every three to six months at first,
        then further apart — and we’ll show you how to check your own skin between visits.
      </p>
      <p>
        If something changes before your next appointment, you don’t wait for it. Call, tell us what
        changed, and we’ll get you in.
      </p>
    </div>
  </SectionBand>

  <!-- 9 · FAQ -->
  <SectionBand tone="fog" aria-labelledby="faq-heading">
    <Faq heading="Questions patients ask" items={faqs} />
  </SectionBand>

  <!-- 10 · Closing CTA + cross-sell -->
  <SectionBand aria-labelledby="cta-heading">
    <div class="closing" data-reveal>
      <h2 id="cta-heading">Request a skin check</h2>
      <p>
        A skin check is a full look at your skin with a dermatoscope, plus a closer look at anything
        you or we are watching. Leave your name and number and our team will call you back. Routine
        checks are often booked months out; a spot that’s new, changing, bleeding, or not healing is
        triaged sooner — tell us when you call.
      </p>
      <div class="closing__cta">
        <Button href="/contact/" variant="primary">Request a skin check</Button>
        <Button href={`tel:${practice.phoneHref}`} variant="secondary">
          Call {practice.phone}
        </Button>
      </div>
      <p class="closing__cross">
        Due for a routine full-skin exam without a specific concern?
        <a class="link-underline" href="/general-dermatology/">
          That’s part of general dermatology
        </a>.
      </p>
    </div>
  </SectionBand>

  <!-- 11 · Referring physicians -->
  <SectionBand tone="evergreen-deep" id="referring-physicians" aria-labelledby="refer-heading">
    <div class="refer" data-reveal>
      <h2 id="refer-heading">For referring physicians</h2>
      <p>
        Dr. Jeffrey Lander is fellowship-trained in Mohs surgery and performs more than 800 cases a
        year. Tissue is processed in our own lab; reconstruction is done here by the same surgeon.
        For patients who aren’t surgical candidates, superficial radiation therapy is
        available on site. Pathology across all of our providers is reviewed weekly by Dr. Moinfar.
      </p>
      <p>
        To refer a patient or discuss a case, call
        <a class="link-underline refer__link" href={`tel:${practice.phoneHref}`}>{practice.phone}</a
        >{
          practice.fax && (
            <>
              {' '}or fax <span class="refer__fax">{practice.fax}</span>
            </>
          )
        }. We see urgent lesions quickly and send your patient back to you with a note.
      </p>
      <!-- TODO(client): confirm the referral fax / secure fax line for src/data/site.ts -->
      <div class="refer__cta">
        <Button href={`tel:${practice.phoneHref}`} variant="secondary">Refer a patient</Button>
      </div>
    </div>
  </SectionBand>
</BaseLayout>

<style>
  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Hero */
  .hero {
    padding-block: var(--space-12) var(--section-y);
  }
  .hero .lede {
    margin-top: var(--space-4);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* What to watch for */
  .watch {
    max-width: 60ch;
  }
  .watch__intro {
    margin-bottom: var(--space-6);
  }
  .watch__note {
    margin-top: var(--space-6);
    color: var(--stone);
  }

  /* The full range */
  .range {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 760px) {
    .range {
      grid-template-columns: 1fr 1fr;
    }
  }
  .range__item h3 {
    margin-bottom: var(--space-3);
  }

  /* Candidacy */
  .candidacy {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 760px) {
    .candidacy {
      grid-template-columns: 1fr 1fr;
    }
  }
  .candidacy__col h3 {
    margin-bottom: var(--space-4);
  }
  .candidacy__col ul {
    padding-left: 1.1rem;
    max-width: 46ch;
  }
  .candidacy__col li + li {
    margin-top: var(--space-3);
  }

  /* Evergreen band prose */
  .band-prose {
    max-width: 60ch;
  }
  .band-prose h2 {
    margin-bottom: var(--space-6);
  }
  .band-prose p + p {
    margin-top: var(--space-6);
  }
  .band-prose__link {
    color: var(--paper);
  }

  /* Who you'll see */
  .team {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 640px) {
    .team {
      grid-template-columns: 1fr 1fr;
    }
  }
  .team__note {
    margin-top: var(--space-12);
    max-width: 60ch;
    color: var(--stone);
  }

  /* Closing */
  .closing {
    max-width: 60ch;
  }
  .closing h2 {
    margin-bottom: var(--space-6);
  }
  .closing__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .closing__cross {
    margin-top: var(--space-8);
    color: var(--stone);
  }

  /* Referring physicians */
  .refer {
    max-width: 60ch;
  }
  .refer h2 {
    margin-bottom: var(--space-6);
  }
  .refer p + p {
    margin-top: var(--space-6);
  }
  .refer__link,
  .refer__fax {
    color: var(--paper);
  }
  .refer__cta {
    margin-top: var(--space-8);
  }
</style>

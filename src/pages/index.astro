---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import Card from '@components/Card.astro';
import Button from '@components/Button.astro';
import ProviderCard from '@components/ProviderCard.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import { practice, providers } from '@data/site';

const title = 'Advanced Dermatology · Dana Point Skin Care Since 2006';
const description =
  'Physician-owned dermatology in Dana Point, CA — medical skin care, skin cancer and Mohs surgery, cosmetic treatments, and GLP-1 recovery. Serving South Orange County since 2006.';

// Four category doors. Language from brand doc §2.1. Brass marker on Cosmetic + GLP-1 Restore.
const doors = [
  {
    href: '/general-dermatology/',
    kicker: 'General dermatology',
    headline: 'We look for the cause before we treat.',
    blurb: 'Acne, eczema, rashes — treated at the cause, so they clear faster.',
    restore: false,
  },
  {
    href: '/skin-cancer/',
    kicker: 'Skin cancer',
    headline: 'Caught early, it’s easier to treat.',
    blurb:
      'Screening, Mohs surgery, radiation therapy, and reconstruction — every stage, in one building.',
    restore: false,
  },
  {
    href: '/cosmetic/',
    kicker: 'Cosmetic',
    headline: 'Nobody should be able to tell.',
    blurb: 'Injectables, lasers, and body contouring, kept deliberately conservative.',
    restore: true,
  },
  {
    href: '/glp-1-restore/',
    kicker: 'GLP-1 Restore',
    headline: 'Weight loss takes more than weight. Now restore the rest.',
    blurb: 'Muscle, hair, and skin — under a physician’s direction.',
    restore: true,
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <!-- 1 · Hero -->
  <SectionBand as="div" class="hero">
    <div class="hero__grid">
      <div class="hero__copy" data-reveal>
        <h1>Serious medicine. Twenty years of it.</h1>
        <p class="hero__tagline">We’ll tell you what you need. And what you don’t.</p>
        <p class="hero__sub">
          Advanced Dermatology is a physician-owned practice in Dana Point, California, serving
          South Orange County since {practice.foundedYear}.
        </p>
        <p class="lede">
          Medical dermatology, skin cancer surgery, and a physician-directed cosmetic and GLP-1
          recovery program — under one roof, one owner, for twenty years.
        </p>
        <div class="hero__cta">
          <Button href="/contact/" variant="primary">Request an appointment</Button>
          <Button href={`tel:${practice.phoneHref}`} variant="secondary">
            Call {practice.phone}
          </Button>
        </div>
      </div>
      <div class="hero__media" data-reveal>
        <PlaceholderImage
          label="building exterior, tight architectural crop, daylight, neutral white balance"
          ratio="4 / 5"
        />
      </div>
    </div>
  </SectionBand>

  <!-- 2 · Four category doors -->
  <SectionBand tone="fog" aria-labelledby="doors-heading">
    <h2 id="doors-heading" class="section-title" data-reveal>Where would you like to start?</h2>
    <div class="doors" data-reveal>
      {
        doors.map((d) => (
          <Card href={d.href} restore={d.restore} class="door">
            <span class="door__kicker">{d.kicker}</span>
            <p class="door__headline">{d.headline}</p>
            <p class="door__blurb">{d.blurb}</p>
            <span class="door__go" aria-hidden="true">
              Learn more →
            </span>
          </Card>
        ))
      }
    </div>
  </SectionBand>

  <!-- 3 · Independence, compressed (brand doc §12.3, verbatim) -->
  <SectionBand tone="evergreen" aria-labelledby="independence-heading">
    <div class="band-prose" data-reveal>
      <h2 id="independence-heading">Who we answer to.</h2>
      <p>
        Most dermatology practices in Orange County have been bought — by hospital systems, by
        private equity, by national groups. Advanced Dermatology hasn’t.
      </p>
      <p>
        It’s why our doctors give patients their cell phone numbers. It’s why we’ve kept a radiation
        unit here, so patients who can’t or shouldn’t have surgery have another option. And it’s why
        we recommend the best treatment, not the most expensive one — because no one here has a
        target to hit.
      </p>
      <p>We treat you the way we’d want our own families treated.</p>
      <p><a class="link-underline band-prose__link" href="/about/">More about the practice</a></p>
    </div>
  </SectionBand>

  <!-- 4 · Who you'll see -->
  <SectionBand tone="fog" id="providers" aria-labelledby="providers-heading">
    <h2 id="providers-heading" class="section-title" data-reveal>Who you’ll see.</h2>
    <div class="providers" data-reveal>
      {providers.map((p) => <ProviderCard provider={p} />)}
    </div>
    <p class="providers__note" data-reveal>
      Dr. Moinfar and Dr. Lander trained together in residency and have practiced side by side for
      nearly twenty-five years. Dermatology has a turnover problem. We don’t.
    </p>
  </SectionBand>

  <!-- 5 · Patient story — reserved slot (brand doc §6.4) -->
  <SectionBand aria-label="Patient stories">
    <div class="story" data-reveal>
      <p class="story__mark">A patient story belongs here.</p>
      <p class="story__body">
        We’re collecting them with written consent, and we won’t publish one until a patient has
        approved every word. Until then, this space stays empty on purpose.
      </p>
    </div>
  </SectionBand>

  <!-- 6 · Location & hours -->
  <SectionBand tone="evergreen-deep" aria-labelledby="location-heading">
    <div class="location" data-reveal>
      <div class="location__info">
        <h2 id="location-heading">Find us.</h2>
        <address class="location__nap">
          {practice.street}<br />
          {practice.city}, {practice.state}
          {practice.postalCode}
        </address>
        <p class="location__line">
          <a class="link-underline location__phone" href={`tel:${practice.phoneHref}`}>
            {practice.phone}
          </a>
        </p>
        <p class="location__hours">
          {practice.hours.map((h) => <span>{h.label}</span>)}
        </p>
        <p class="location__parking">
          Ground-floor suite with parking directly outside. TODO(client): confirm exact parking /
          access details.
        </p>
        <div class="location__cta">
          <Button href="/contact/" variant="primary">Request an appointment</Button>
        </div>
      </div>
      <div class="location__map">
        <PlaceholderImage
          label="exterior wayfinding / street view of the building entrance, daylight"
          ratio="4 / 3"
        />
      </div>
    </div>
  </SectionBand>
</BaseLayout>

<style>
  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Hero */
  .hero {
    padding-block: var(--section-y);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }
  .hero__tagline {
    font-family: var(--display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--evergreen);
    margin-top: var(--space-4);
    max-width: 28ch;
  }
  .hero__sub {
    color: var(--stone);
    margin: var(--space-4) 0 var(--space-6);
    max-width: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .hero__media {
    max-width: 420px;
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-24);
    }
  }

  /* Doors */
  .doors {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 640px) {
    .doors {
      grid-template-columns: 1fr 1fr;
    }
  }
  .door__kicker {
    font-family: var(--body);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--stone);
    display: block;
    margin-bottom: var(--space-3);
  }
  .door__headline {
    font-family: var(--display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--evergreen);
    margin-bottom: var(--space-3);
  }
  .door__blurb {
    color: var(--stone);
    margin-bottom: var(--space-4);
  }
  .door__go {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--evergreen);
  }
  .card--restore .door__go {
    color: var(--brass-deep);
  }

  /* Evergreen band prose */
  .band-prose {
    max-width: 60ch;
  }
  .band-prose h2 {
    margin-bottom: var(--space-6);
  }
  .band-prose p + p {
    margin-top: var(--space-6);
  }
  .band-prose__link {
    color: var(--paper);
  }

  /* Providers */
  .providers {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 640px) {
    .providers {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .providers {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .providers__note {
    margin-top: var(--space-12);
    max-width: 60ch;
    color: var(--stone);
  }

  /* Patient story */
  .story {
    max-width: 54ch;
    border-left: 3px solid var(--line);
    padding-left: var(--space-8);
  }
  .story__mark {
    font-family: var(--display);
    font-size: var(--fs-h3);
    color: var(--evergreen);
    margin-bottom: var(--space-4);
  }
  .story__body {
    color: var(--stone);
  }

  /* Location */
  .location {
    display: grid;
    gap: var(--space-12);
  }
  .location__nap {
    font-style: normal;
    font-size: var(--fs-lede);
    line-height: 1.6;
    margin: var(--space-6) 0 var(--space-4);
  }
  .location__phone {
    color: var(--paper);
  }
  .location__hours {
    display: flex;
    flex-direction: column;
    color: #cdd8d0;
    margin-bottom: var(--space-4);
  }
  .location__parking {
    color: #cdd8d0;
    max-width: 46ch;
    margin-bottom: var(--space-8);
  }
  @media (min-width: 900px) {
    .location {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>

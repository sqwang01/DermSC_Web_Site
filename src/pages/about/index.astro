---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import ProviderCard from '@components/ProviderCard.astro';
import StubNotice from '@components/StubNotice.astro';
import { providers } from '@data/site';
---

<BaseLayout
  title="About Advanced Dermatology · Dana Point"
  description="Advanced Dermatology is a physician-owned practice in Dana Point, California, founded by Dr. Maryam Moinfar in 2006. It has never been sold to a hospital system or private equity group."
  path="/about/"
>
  <SectionBand>
    <h1>Independent since 2006.</h1>
    <p class="lede">
      Advanced Dermatology is a physician-owned dermatology practice in Dana Point, California.
      Founded by Dr. Maryam Moinfar in 2006, it provides medical dermatology and skin cancer care
      alongside Restore, its physician-directed hair, body, and cosmetic program.
    </p>
  </SectionBand>

  <SectionBand tone="fog" id="providers" aria-labelledby="team-heading">
    <div class="team-intro">
      <h2 id="team-heading">The people you’ll actually see</h2>
      <p>
        Two of the four clinicians on this page started at Advanced Dermatology as medical
        assistants. That isn’t a coincidence we’re proud of after the fact — it’s how this practice
        has always built its team, and a big part of why patients here tend to recognize the same
        faces year after year.
      </p>
      <p>
        Dr. Moinfar and Dr. Lander are both board-certified dermatologists and Diplomates of the
        American Board of Dermatology. Nearly every biopsy report in this practice is reviewed by Dr. Moinfar
        personally, every week, across every provider — a second review on every diagnosis before it
        becomes a treatment plan.
      </p>
    </div>
    <div class="team">
      {providers.map((p) => <ProviderCard provider={p} />)}
    </div>
  </SectionBand>

  <SectionBand>
    <StubNotice spec="docs/content-spec.md → About (independence explainer §7.5 verbatim)" />
  </SectionBand>
</BaseLayout>

<style>
  .team-intro {
    max-width: 60ch;
    margin-bottom: var(--space-12);
  }
  .team-intro h2 {
    margin-bottom: var(--space-6);
  }
  .team-intro p + p {
    margin-top: var(--space-6);
  }
  .team {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 640px) {
    .team {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .team {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

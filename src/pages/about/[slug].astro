---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionBand from '@components/SectionBand.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Button from '@components/Button.astro';
import { providers, siteMeta, practice, cta } from '@data/site';

export const getStaticPaths = (() => {
  return providers.map((p) => ({ params: { slug: p.slug }, props: { provider: p } }));
}) satisfies GetStaticPaths;

const { provider } = Astro.props;
const path = `/about/${provider.slug}/`;

// "Dr. Maryam Moinfar" -> "Dr. Moinfar"; "Madeline Fee, PA-C" -> "Madeline"
const parts = provider.name.replace(/,.*$/, '').split(' ');
const shortName = provider.name.startsWith('Dr.')
  ? `Dr. ${parts[parts.length - 1]}`
  : parts[0];

const physicianSchema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: provider.name,
  medicalSpecialty: 'Dermatology',
  ...(provider.role ? { jobTitle: provider.role } : {}),
  image: new URL(provider.photo.src, siteMeta.origin).href,
  worksFor: {
    '@type': 'MedicalBusiness',
    name: practice.legalName,
    '@id': `${siteMeta.origin}/#practice`,
  },
  url: new URL(path, siteMeta.origin).href,
};
---

<BaseLayout
  title={`${provider.name} · Advanced Dermatology`}
  description={provider.metaDescription}
  path={path}
  schema={[physicianSchema]}
>
  <SectionBand>
    <Breadcrumbs
      crumbs={[{ label: provider.name, href: '/about/' }]}
      backAriaLabel="Back to About"
    />
    <div class="bio">
      <div class="bio__aside">
        <Image
          class="bio__photo"
          src={provider.photo}
          alt={provider.photoAlt}
          width={440}
          height={440}
          densities={[1, 2]}
        />
        <p class="bio__accepting">{provider.accepting}</p>
      </div>

      <div class="bio__body prose">
        <h1>{provider.name}</h1>
        <p class="bio__cred">{provider.credential}</p>
        <p class="lede">{provider.bioLede}</p>
        {provider.role && <p class="bio__role">{provider.role}</p>}

        <h2>How {shortName} practices</h2>
        {
          provider.bioBody.map((para) => (
            <p id={para.endsWith('an operating room.') ? 'hair-focus' : undefined}>
              {para}
            </p>
          ))
        }

        <h2>Education and training</h2>
        <p>{provider.education}</p>

        {provider.humanNote && <p>{provider.humanNote}</p>}

        <p class="bio__cta">
          <Button href="/contact/">{cta.medical.primary}</Button>
        </p>
      </div>
    </div>
  </SectionBand>
</BaseLayout>

<style>
  .bio {
    --aside-w: 240px;
    display: grid;
    gap: var(--space-12);
  }
  .bio__photo {
    width: 100%;
    max-width: var(--aside-w);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .bio__accepting {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    color: var(--stone);
    max-width: var(--aside-w);
  }
  .bio__cred {
    color: var(--stone);
    margin: var(--space-2) 0 var(--space-6);
  }
  .bio__role {
    color: var(--stone);
  }
  .bio__cta {
    margin-top: var(--space-12);
  }
  @media (min-width: 820px) {
    .bio {
      grid-template-columns: var(--aside-w) 1fr;
    }
  }
</style>

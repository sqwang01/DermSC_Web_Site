{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/cosmetic-dermatology-dana-point",
      "destination": "/cosmetic/",
      "permanent": true
    },
    {
      "source": "/cosmetic-dermatology-dana-point/",
      "destination": "/cosmetic/",
      "permanent": true
    },
    { "source": "/surgical-dermatology-92629", "destination": "/skin-cancer/", "permanent": true },
    { "source": "/surgical-dermatology-92629/", "destination": "/skin-cancer/", "permanent": true },
    {
      "source": "/skin-cancer-treatment-dana-point",
      "destination": "/skin-cancer/",
      "permanent": true
    },
    {
      "source": "/skin-cancer-treatment-dana-point/",
      "destination": "/skin-cancer/",
      "permanent": true
    },
    { "source": "/coolsculpting", "destination": "/cosmetic/coolsculpting/", "permanent": true },
    { "source": "/coolsculpting/", "destination": "/cosmetic/coolsculpting/", "permanent": true },
    { "source": "/emsculpt-neo", "destination": "/cosmetic/emsculpt-neo/", "permanent": true },
    { "source": "/emsculpt-neo/", "destination": "/cosmetic/emsculpt-neo/", "permanent": true },
    {
      "source": "/cosmetic/injectables-and-laser",
      "destination": "/cosmetic/",
      "permanent": true
    },
    {
      "source": "/cosmetic/injectables-and-laser/",
      "destination": "/cosmetic/",
      "permanent": true
    },
    { "source": "/cosmetic/restore-membership", "destination": "/cosmetic/", "permanent": true },
    { "source": "/cosmetic/restore-membership/", "destination": "/cosmetic/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
